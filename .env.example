# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，切勿提交真实密钥
# 不配置时默认使用离线 Mock 模型（LLM_PROVIDER=mock），无需任何密钥即可运行

# mock | openai
LLM_PROVIDER=mock

# 仅 LLM_PROVIDER=openai 时需要（OpenAI 兼容接口，如内部网关 / csu / vLLM 服务）
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=GLM
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT=120
